rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'akash.abdur.2002@gmail.com';
    }

    function isMainAdmin() {
      return isBootstrapAdmin();
    }

    function isAdmin() {
      return isMainAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidImageField(val) {
      return val is string && (
        val == '' ||
        (val.size() <= 512 && (val.matches('^https://.*') || val.matches('^/src/assets/.*'))) ||
        (val.size() <= 140000 && val.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$'))
      );
    }

    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'level', 'rating', 'sellCount', 'buyCount', 'joinedLabel', 'role', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'avatarUrl', 'level', 'rating', 'sellCount', 'buyCount', 'joinedLabel', 'role', 'updatedAt'])
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512))
        && data.level is number && data.level >= 1 && data.level <= 100
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.sellCount is number && data.sellCount >= 0
        && data.buyCount is number && data.buyCount >= 0
        && data.joinedLabel is string && data.joinedLabel.size() <= 32
        && data.role in ['user', 'admin']
        && data.updatedAt == request.time;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'payoutMethod', 'updatedAt'])
        && data.uid == userId
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('payoutMethod' in data) || (data.payoutMethod in ['bKash', 'Nagad']))
        && data.updatedAt == request.time;
    }

    function isValidAdminAgent(data, adminId) {
      return data.keys().hasAll(['uid', 'name', 'verified', 'reviewNotes', 'completedDeals', 'rating'])
        && data.keys().hasOnly([
          'uid', 'name', 'verified', 'staffRole', 'email', 'phoneMasked',
          'idType', 'idLast4', 'appointedBy', 'inviteId', 'verificationBadges',
          'specialty', 'reviewNotes', 'completedDeals', 'rating'
        ])
        && data.uid == adminId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.verified is bool
        && (!('staffRole' in data) || (data.staffRole in ['main_admin', 'sub_admin', 'moderator']))
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('phoneMasked' in data) || (data.phoneMasked is string && data.phoneMasked.size() <= 32))
        && (!('idType' in data) || (data.idType in ['NID', 'Passport', 'StudentID']))
        && (!('idLast4' in data) || (data.idLast4 is string && data.idLast4.size() <= 8))
        && (!('appointedBy' in data) || (data.appointedBy is string && data.appointedBy.size() <= 128))
        && (!('inviteId' in data) || (data.inviteId is string && data.inviteId.size() <= 128))
        && (!('verificationBadges' in data) || (
          data.verificationBadges is map &&
          data.verificationBadges.keys().hasOnly(['emailVerified', 'mobileVerified', 'idVerified'])
        ))
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 160))
        && data.reviewNotes is string && data.reviewNotes.size() <= 500
        && data.completedDeals is number && data.completedDeals >= 0
        && data.rating is number && data.rating >= 0 && data.rating <= 5;
    }

    function isValidTeamInvite(data, inviteId) {
      return data.keys().hasAll([
          'id', 'candidateEmail', 'candidateName', 'candidatePhone',
          'idType', 'idLast4', 'staffRole', 'verificationCode',
          'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'candidateEmail', 'candidateName', 'candidatePhone',
          'idType', 'idLast4', 'staffRole', 'specialty',
          'verificationCode', 'status', 'createdBy', 'claimedUid',
          'createdAt', 'updatedAt'
        ])
        && data.id == inviteId
        && data.candidateEmail is string && data.candidateEmail.size() >= 5 && data.candidateEmail.size() <= 160
        && data.candidateName is string && data.candidateName.size() >= 1 && data.candidateName.size() <= 80
        && data.candidatePhone is string && data.candidatePhone.size() >= 6 && data.candidatePhone.size() <= 32
        && data.idType in ['NID', 'Passport', 'StudentID']
        && data.idLast4 is string && data.idLast4.size() >= 2 && data.idLast4.size() <= 8
        && data.staffRole in ['sub_admin', 'moderator']
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 160))
        && data.verificationCode is string && data.verificationCode.size() >= 6 && data.verificationCode.size() <= 12
        && data.status in ['pending', 'verified', 'revoked']
        && isValidId(data.createdBy)
        && (!('claimedUid' in data) || (data.claimedUid is string && data.claimedUid.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidPaymentSession(data, sessionId) {
      return data.keys().hasAll([
          'id', 'dealId', 'buyerId', 'method', 'amount', 'mode',
          'status', 'gatewayPaymentId', 'expiresAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'dealId', 'buyerId', 'method', 'amount', 'mode',
          'status', 'gatewayPaymentId', 'trxId', 'senderMasked',
          'redirectUrl', 'expiresAt', 'createdAt', 'updatedAt'
        ])
        && data.id == sessionId
        && isValidId(data.dealId)
        && isValidId(data.buyerId)
        && data.method in ['bKash', 'Nagad']
        && data.amount is number && data.amount >= 1 && data.amount <= 1000000
        && data.mode in ['live_api', 'sandbox']
        && data.status in ['initiated', 'authorized', 'verified', 'failed', 'expired']
        && data.gatewayPaymentId is string && data.gatewayPaymentId.size() >= 1 && data.gatewayPaymentId.size() <= 128
        && (!('trxId' in data) || (data.trxId is string && data.trxId.size() <= 32))
        && (!('senderMasked' in data) || (data.senderMasked is string && data.senderMasked.size() <= 32))
        && (!('redirectUrl' in data) || (data.redirectUrl is string && data.redirectUrl.size() <= 512))
        && data.expiresAt is string && data.expiresAt.size() >= 10 && data.expiresAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidListing(data, listingId) {
      return data.keys().hasAll(['id', 'sellerId', 'sellerName', 'category', 'title', 'linkType', 'price', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'sellerId', 'sellerName', 'category', 'title', 'description', 'imageUrl', 'paidCount', 'linkType', 'server', 'limitInfo', 'price', 'rating', 'status', 'createdAt', 'updatedAt'])
        && data.id == listingId
        && isValidId(data.sellerId)
        && data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80
        && data.category in ['eFootball', 'PUBG Mobile', 'Free Fire', 'Mobile Legends', 'Other']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('imageUrl' in data) || isValidImageField(data.imageUrl))
        && (!('paidCount' in data) || (data.paidCount is string && data.paidCount.size() <= 32))
        && data.linkType in ['Only Konami', 'Konami + Glink', 'Konami + iOSlink', 'Gg Lost']
        && (!('server' in data) || (data.server is string && data.server.size() <= 60))
        && (!('limitInfo' in data) || (data.limitInfo is string && data.limitInfo.size() <= 40))
        && data.price is number && data.price >= 0 && data.price <= 1000000
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && data.status in ['active', 'in_deal', 'sold']
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidComment(data, commentId, listingId) {
      return data.keys().hasAll(['id', 'listingId', 'authorId', 'authorName', 'text', 'createdAt'])
        && data.keys().hasOnly(['id', 'listingId', 'authorId', 'authorName', 'text', 'parentCommentId', 'replyToAuthor', 'likedBy', 'createdAt'])
        && data.id == commentId
        && data.listingId == listingId
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
        && (!('parentCommentId' in data) || isValidId(data.parentCommentId))
        && (!('replyToAuthor' in data) || (data.replyToAuthor is string && data.replyToAuthor.size() <= 80))
        && (!('likedBy' in data) || (data.likedBy is list && data.likedBy.size() <= 500 && (data.likedBy.size() == 0 || data.likedBy[0] is string)))
        && data.createdAt is timestamp;
    }

    function isValidSearchTerm(data, termId) {
      return data.keys().hasAll(['id', 'term', 'normalizedTerm', 'searchCount', 'lastSearchedAt', 'createdAt'])
        && data.keys().hasOnly(['id', 'term', 'normalizedTerm', 'searchCount', 'lastCategory', 'lastResultCount', 'lastSearchedBy', 'lastSearchedAt', 'createdAt'])
        && data.id == termId
        && data.term is string && data.term.size() >= 1 && data.term.size() <= 80
        && data.normalizedTerm is string && data.normalizedTerm.size() >= 2 && data.normalizedTerm.size() <= 80
        && data.searchCount is number && data.searchCount >= 1
        && (!('lastCategory' in data) || (data.lastCategory in ['All', 'eFootball', 'PUBG Mobile', 'Free Fire', 'Mobile Legends', 'Other']))
        && (!('lastResultCount' in data) || (data.lastResultCount is number && data.lastResultCount >= 0))
        && (!('lastSearchedBy' in data) || (data.lastSearchedBy == request.auth.uid))
        && data.lastSearchedAt == request.time
        && data.createdAt is timestamp;
    }

    function isValidConversation(data, convId) {
      return data.keys().hasAll(['id', 'listingId', 'buyerId', 'sellerId', 'offerStatus', 'updatedAt'])
        && data.keys().hasOnly(['id', 'listingId', 'listingTitle', 'listingPrice', 'listingImage', 'buyerId', 'buyerName', 'sellerId', 'sellerName', 'lastMessage', 'unreadCount', 'negotiatedPrice', 'offerStatus', 'dealId', 'isSupport', 'updatedAt'])
        && data.id == convId
        && isValidId(data.listingId)
        && isValidId(data.buyerId)
        && isValidId(data.sellerId)
        && (!('listingTitle' in data) || (data.listingTitle is string && data.listingTitle.size() <= 120))
        && (!('listingPrice' in data) || (data.listingPrice is number && data.listingPrice >= 0))
        && (!('listingImage' in data) || isValidImageField(data.listingImage))
        && (!('buyerName' in data) || (data.buyerName is string && data.buyerName.size() <= 80))
        && (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() <= 80))
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 300))
        && (!('unreadCount' in data) || (data.unreadCount is number && data.unreadCount >= 0))
        && (!('negotiatedPrice' in data) || (data.negotiatedPrice is number && data.negotiatedPrice >= 0))
        && data.offerStatus in ['none', 'offered', 'accepted', 'declined']
        && (!('dealId' in data) || (data.dealId is string && data.dealId.size() <= 128))
        && (!('isSupport' in data) || data.isSupport is bool)
        && data.updatedAt == request.time;
    }

    function isValidMessage(data, msgId) {
      return data.keys().hasAll(['id', 'senderId', 'senderName', 'text', 'type', 'createdAt'])
        && data.keys().hasOnly(['id', 'senderId', 'senderName', 'text', 'type', 'offerAmount', 'createdAt'])
        && data.id == msgId
        && (data.senderId == request.auth.uid || (data.senderId == 'system' && isAdmin()))
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 800
        && data.type in ['text', 'offer', 'system', 'proof', 'account_details']
        && (!('offerAmount' in data) || (data.offerAmount is number && data.offerAmount >= 0))
        && data.createdAt == request.time;
    }

    function isValidDeal(data, dealId) {
      return data.keys().hasAll(['id', 'conversationId', 'listingId', 'buyerId', 'sellerId', 'agreedAmount', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'title', 'conversationId', 'listingId', 'listingTitle', 'listingImage',
          'buyerId', 'buyerName', 'sellerId', 'sellerName', 'adminId', 'adminName',
          'agreedAmount', 'serviceType', 'serviceFee', 'buyerMethod', 'sellerMethod',
          'crossDealRequired', 'crossDealAccepted', 'crossDealFee',
          'iosCheck', 'googleBindCheck', 'verificationFee', 'totalAmount',
          'paymentContact', 'paymentProofNote', 'paymentProofUrl',
          'buyerInitialDone', 'sellerExchanged', 'accountDetailsNote',
          'reviewRating', 'reviewComment', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id == dealId
        && (!('title' in data) || (data.title is string && data.title.size() >= 1 && data.title.size() <= 120))
        && isValidId(data.conversationId)
        && isValidId(data.listingId)
        && (!('listingTitle' in data) || (data.listingTitle is string && data.listingTitle.size() <= 120))
        && (!('listingImage' in data) || isValidImageField(data.listingImage))
        && isValidId(data.buyerId)
        && (!('buyerName' in data) || (data.buyerName is string && data.buyerName.size() <= 80))
        && isValidId(data.sellerId)
        && (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() <= 80))
        && (!('adminId' in data) || (data.adminId is string && data.adminId.size() <= 128))
        && (!('adminName' in data) || (data.adminName is string && data.adminName.size() <= 80))
        && data.agreedAmount is number && data.agreedAmount >= 0 && data.agreedAmount <= 1000000
        && (!('serviceType' in data) || (data.serviceType in ['pending', 'normal', 'ultimate_safe']))
        && (!('serviceFee' in data) || (data.serviceFee is number && data.serviceFee >= 0))
        && (!('buyerMethod' in data) || (data.buyerMethod in ['pending', 'bKash', 'Nagad']))
        && (!('sellerMethod' in data) || (data.sellerMethod in ['pending', 'bKash', 'Nagad']))
        && (!('crossDealRequired' in data) || data.crossDealRequired is bool)
        && (!('crossDealAccepted' in data) || data.crossDealAccepted is bool)
        && (!('crossDealFee' in data) || (data.crossDealFee is number && data.crossDealFee >= 0))
        && (!('iosCheck' in data) || data.iosCheck is bool)
        && (!('googleBindCheck' in data) || data.googleBindCheck is bool)
        && (!('verificationFee' in data) || (data.verificationFee is number && data.verificationFee >= 0))
        && (!('totalAmount' in data) || (data.totalAmount is number && data.totalAmount >= 0))
        && (!('paymentContact' in data) || (data.paymentContact is string && data.paymentContact.size() <= 120))
        && (!('paymentProofNote' in data) || (data.paymentProofNote is string && data.paymentProofNote.size() <= 300))
        && (!('paymentProofUrl' in data) || isValidImageField(data.paymentProofUrl))
        && (!('buyerInitialDone' in data) || data.buyerInitialDone is bool)
        && (!('sellerExchanged' in data) || data.sellerExchanged is bool)
        && (!('accountDetailsNote' in data) || (data.accountDetailsNote is string && data.accountDetailsNote.size() <= 500))
        && (!('reviewRating' in data) || (data.reviewRating is number && data.reviewRating >= 1 && data.reviewRating <= 5))
        && (!('reviewComment' in data) || (data.reviewComment is string && data.reviewComment.size() <= 500))
        && data.status in ['confirming', 'finding_admin', 'service_select', 'payment_method', 'cross_deal', 'verification_checks', 'cost_summary', 'payment_instruction', 'payment_received', 'id_exchange', 'review_prompt', 'done', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidReview(data, reviewId, dealId) {
      return data.keys().hasAll(['id', 'dealId', 'reviewerId', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['id', 'dealId', 'reviewerId', 'reviewerName', 'targetAdminName', 'rating', 'comment', 'createdAt'])
        && data.id == reviewId
        && data.dealId == dealId
        && data.reviewerId == request.auth.uid
        && (!('reviewerName' in data) || (data.reviewerName is string && data.reviewerName.size() <= 80))
        && (!('targetAdminName' in data) || (data.targetAdminName is string && data.targetAdminName.size() <= 80))
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 500
        && data.createdAt == request.time;
    }

    function isValidNotification(data, notifId) {
      return data.keys().hasAll(['id', 'recipientId', 'actorName', 'message', 'isRead', 'createdAt'])
        && data.keys().hasOnly(['id', 'recipientId', 'actorName', 'message', 'targetType', 'targetId', 'isRead', 'createdAt'])
        && data.id == notifId
        && isValidId(data.recipientId)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 240
        && (!('targetType' in data) || (data.targetType in ['listing', 'deal', 'conversation', 'system']))
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && data.isRead is bool
        && data.createdAt == request.time;
    }

    function isValidStatement(data, stmtId) {
      return data.keys().hasAll(['id', 'userId', 'dealId', 'title', 'type', 'amount', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'dealId', 'title', 'type', 'amount', 'feeAmount', 'netAmount', 'method', 'createdAt'])
        && data.id == stmtId
        && isValidId(data.userId)
        && isValidId(data.dealId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.type in ['sell_income', 'buy_payment', 'admin_fee_income']
        && data.amount is number && data.amount >= 0
        && (!('feeAmount' in data) || (data.feeAmount is number && data.feeAmount >= 0))
        && (!('netAmount' in data) || (data.netAmount is number && data.netAmount >= 0))
        && (!('method' in data) || (data.method in ['bKash', 'Nagad']))
        && data.createdAt == request.time;
    }

    function isValidPlatformConfig(data, configId) {
      return data.keys().hasAll(['id', 'bkashNumber', 'nagadNumber', 'escrowLabel', 'updatedAt'])
        && data.keys().hasOnly(['id', 'bkashNumber', 'nagadNumber', 'bkashAccountType', 'nagadAccountType', 'bkashPaymentLink', 'nagadPaymentLink', 'escrowLabel', 'announcement', 'updatedAt'])
        && data.id == configId
        && data.bkashNumber is string && data.bkashNumber.size() >= 6 && data.bkashNumber.size() <= 32
        && data.nagadNumber is string && data.nagadNumber.size() >= 6 && data.nagadNumber.size() <= 32
        && (!('bkashAccountType' in data) || (data.bkashAccountType in ['Personal', 'Merchant', 'Agent']))
        && (!('nagadAccountType' in data) || (data.nagadAccountType in ['Personal', 'Merchant', 'Agent']))
        && (!('bkashPaymentLink' in data) || (data.bkashPaymentLink is string && data.bkashPaymentLink.size() <= 240 && (data.bkashPaymentLink == '' || data.bkashPaymentLink.matches('^https://.*'))))
        && (!('nagadPaymentLink' in data) || (data.nagadPaymentLink is string && data.nagadPaymentLink.size() <= 240 && (data.nagadPaymentLink == '' || data.nagadPaymentLink.matches('^https://.*'))))
        && data.escrowLabel is string && data.escrowLabel.size() >= 2 && data.escrowLabel.size() <= 80
        && (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 240))
        && data.updatedAt == request.time;
    }

    // Users public & isolated private PII
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isBootstrapAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && (incoming().role == 'user' || isAdmin());
      allow update: if isValidId(userId)
        && isValidUserPublic(incoming(), userId)
        && (
          isAdmin() ||
          (isVerifiedUser() && isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && (isAdmin() || (isVerifiedUser() && isOwner(userId)));

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isBootstrapAdmin();
        allow create, update: if isValidId(userId) && isValidId(docId) && isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidUserPrivate(incoming(), userId);
        allow delete: if isValidId(userId) && isValidId(docId) && ((isVerifiedUser() && isOwner(userId)) || isAdmin());
      }
    }

    // Verified admin mediators (Main Admin appoints/updates/deletes; invited staff self-claim atomically or self-delete account)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.verified in [true, false];
      allow create: if isValidId(adminId)
        && isValidAdminAgent(incoming(), adminId)
        && (
          isMainAdmin() ||
          (
            isVerifiedUser()
            && adminId == request.auth.uid
            && incoming().staffRole in ['sub_admin', 'moderator']
            && 'inviteId' in incoming()
            && incoming().inviteId is string
            && isValidId(incoming().inviteId)
            && getAfter(/databases/$(database)/documents/teamInvites/$(incoming().inviteId)).data.status == 'verified'
            && getAfter(/databases/$(database)/documents/teamInvites/$(incoming().inviteId)).data.claimedUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/teamInvites/$(incoming().inviteId)).data.staffRole == incoming().staffRole
            && getAfter(/databases/$(database)/documents/teamInvites/$(incoming().inviteId)).data.candidateEmail == request.auth.token.email
          )
        );
      allow update: if isValidId(adminId) && isMainAdmin() && isValidAdminAgent(incoming(), adminId);
      allow delete: if isValidId(adminId)
        && adminId != 'admin_abdur'
        && (
          (isMainAdmin() && adminId != request.auth.uid) ||
          (isVerifiedUser() && adminId == request.auth.uid)
        );
    }

    // Smart verification invitations issued exclusively by Main Project Admin
    match /teamInvites/{inviteId} {
      allow get: if isValidId(inviteId) && (isMainAdmin() || (isVerifiedUser() && existing().candidateEmail == request.auth.token.email));
      allow list: if isMainAdmin() || (isVerifiedUser() && resource.data.candidateEmail == request.auth.token.email);
      allow create: if isValidId(inviteId)
        && isMainAdmin()
        && isValidTeamInvite(incoming(), inviteId)
        && incoming().status == 'pending'
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(inviteId)
        && isValidTeamInvite(incoming(), inviteId)
        && incoming().candidateEmail == existing().candidateEmail
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (
          isMainAdmin() ||
          (
            isVerifiedUser()
            && existing().status == 'pending'
            && incoming().status == 'verified'
            && existing().candidateEmail == request.auth.token.email
            && incoming().claimedUid == request.auth.uid
            && incoming().staffRole == existing().staffRole
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedUid', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid))
          )
        );
      allow delete: if isValidId(inviteId) && isMainAdmin();
    }

    // Public marketplace listings & comments with likes/replies
    match /listings/{listingId} {
      allow get: if isValidId(listingId);
      allow list: if resource.data.status in ['active', 'in_deal', 'sold'];
      allow create: if isValidId(listingId)
        && isVerifiedUser()
        && isValidListing(incoming(), listingId)
        && incoming().sellerId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(listingId)
        && isValidListing(incoming(), listingId)
        && incoming().sellerId == existing().sellerId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (isVerifiedUser() && existing().sellerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'price', 'status', 'updatedAt']) && incoming().status in ['active', 'in_deal'])
        );
      allow delete: if isValidId(listingId) && (isAdmin() || (isVerifiedUser() && existing().sellerId == request.auth.uid));

      match /comments/{commentId} {
        allow get: if isValidId(listingId) && isValidId(commentId);
        allow list: if resource.data.listingId == listingId;
        allow create: if isValidId(listingId)
          && isValidId(commentId)
          && isVerifiedUser()
          && exists(/databases/$(database)/documents/listings/$(listingId))
          && isValidComment(incoming(), commentId, listingId)
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && (!('likedBy' in incoming()) || incoming().likedBy.size() == 0);
        allow update: if isValidId(listingId)
          && isValidId(commentId)
          && isVerifiedUser()
          && isValidComment(incoming(), commentId, listingId)
          && incoming().authorId == existing().authorId
          && incoming().authorName == existing().authorName
          && incoming().text == existing().text
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['likedBy'])
          && 'likedBy' in incoming()
          && incoming().likedBy.size() <= existing().get('likedBy', []).size() + 1;
        allow delete: if isValidId(listingId)
          && isValidId(commentId)
          && (
            isAdmin() ||
            (isVerifiedUser() && (
              existing().authorId == request.auth.uid ||
              get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid
            ))
          );
      }
    }

    // Aggregated marketplace search term analytics
    match /searchTerms/{termId} {
      allow get: if isValidId(termId) && isSignedIn();
      allow list: if isBootstrapAdmin() || (isSignedIn() && resource.data.searchCount >= 1);
      allow create: if isValidId(termId)
        && isVerifiedUser()
        && isValidSearchTerm(incoming(), termId)
        && incoming().searchCount == 1
        && incoming().createdAt == request.time;
      allow update: if isValidId(termId)
        && isVerifiedUser()
        && isValidSearchTerm(incoming(), termId)
        && incoming().normalizedTerm == existing().normalizedTerm
        && incoming().createdAt == existing().createdAt
        && incoming().searchCount == existing().searchCount + 1;
      allow delete: if isValidId(termId) && isMainAdmin();
    }

    // Direct buyer-seller conversations
    match /conversations/{conversationId} {
      function isConvMember(conv) {
        return isSignedIn() && (request.auth.uid == conv.buyerId || request.auth.uid == conv.sellerId);
      }

      allow get: if isValidId(conversationId) && (isConvMember(existing()) || isAdmin());
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isBootstrapAdmin());
      allow create: if isValidId(conversationId)
        && isVerifiedUser()
        && isValidConversation(incoming(), conversationId)
        && (incoming().buyerId == request.auth.uid || incoming().sellerId == request.auth.uid)
        && ((('isSupport' in incoming()) && incoming().isSupport == true && incoming().listingId == 'admin_support') || exists(/databases/$(database)/documents/listings/$(incoming().listingId)));
      allow update: if isValidId(conversationId)
        && isValidConversation(incoming(), conversationId)
        && incoming().buyerId == existing().buyerId
        && incoming().sellerId == existing().sellerId
        && incoming().listingId == existing().listingId
        && (
          isAdmin() ||
          (isVerifiedUser() && isConvMember(existing()) && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'unreadCount', 'negotiatedPrice', 'offerStatus', 'dealId', 'updatedAt']))
        );
      allow delete: if isValidId(conversationId) && (isMainAdmin() || (isVerifiedUser() && isConvMember(existing())));

      match /messages/{messageId} {
        function parentConv() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow get: if isValidId(conversationId) && isValidId(messageId) && (isConvMember(parentConv()) || isAdmin());
        allow list: if isSignedIn() && (isConvMember(parentConv()) || isAdmin());
        allow create: if isValidId(conversationId)
          && isValidId(messageId)
          && isVerifiedUser()
          && isConvMember(parentConv())
          && isValidMessage(incoming(), messageId);
        allow delete: if isValidId(conversationId) && isValidId(messageId) && (isMainAdmin() || (isVerifiedUser() && isConvMember(parentConv())));
      }
    }

    // Admin-mediated escrow deals (Hardened: Only Admins can verify payment or release payout/complete)
    match /deals/{dealId} {
      function isDealParticipant(d) {
        return isSignedIn() && (request.auth.uid == d.buyerId || request.auth.uid == d.sellerId || request.auth.uid == d.adminId);
      }

      allow get: if isValidId(dealId) && (isDealParticipant(existing()) || isAdmin());
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.adminId == request.auth.uid || isBootstrapAdmin());
      allow create: if isValidId(dealId)
        && isVerifiedUser()
        && isValidDeal(incoming(), dealId)
        && exists(/databases/$(database)/documents/listings/$(incoming().listingId))
        && incoming().buyerId != incoming().sellerId
        && incoming().agreedAmount >= 50
        && (!('serviceFee' in incoming()) || incoming().serviceFee == 0)
        && (!('crossDealFee' in incoming()) || incoming().crossDealFee == 0)
        && (!('verificationFee' in incoming()) || incoming().verificationFee == 0)
        && (!('totalAmount' in incoming()) || incoming().totalAmount == incoming().agreedAmount)
        && (incoming().buyerId == request.auth.uid || incoming().sellerId == request.auth.uid)
        && incoming().status == 'confirming'
        && incoming().buyerInitialDone == false
        && incoming().sellerExchanged == false
        && incoming().createdAt == request.time;
      allow update: if isValidId(dealId)
        && isValidDeal(incoming(), dealId)
        && incoming().buyerId == existing().buyerId
        && incoming().sellerId == existing().sellerId
        && incoming().listingId == existing().listingId
        && incoming().conversationId == existing().conversationId
        && incoming().paymentContact == existing().paymentContact
        && incoming().createdAt == existing().createdAt
        && incoming().agreedAmount == existing().agreedAmount
        && (
          isAdmin() ||
          (
            isVerifiedUser()
            && isDealParticipant(existing())
            && !(existing().status in ['done', 'cancelled'])
            && (
              // Action 1: Configure service, payment methods, cross-deal, verification options before payment
              (
                existing().status in ['confirming', 'finding_admin', 'service_select', 'payment_method', 'cross_deal', 'verification_checks', 'cost_summary']
                && incoming().status in ['finding_admin', 'service_select', 'payment_method', 'cross_deal', 'verification_checks', 'cost_summary', 'payment_instruction', 'cancelled']
                && incoming().buyerInitialDone == false
                && incoming().sellerExchanged == existing().sellerExchanged
                && incoming().adminId == existing().adminId
                && incoming().totalAmount >= incoming().agreedAmount
                && (!('serviceType' in incoming()) || incoming().serviceType != 'ultimate_safe' || incoming().serviceFee == 60)
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'serviceType', 'serviceFee', 'buyerMethod', 'sellerMethod',
                  'crossDealRequired', 'crossDealAccepted', 'crossDealFee',
                  'iosCheck', 'googleBindCheck', 'verificationFee',
                  'totalAmount', 'status', 'updatedAt'
                ])
              ) ||
              // Action 2: Buyer submits TrxID / payment proof note (Admin must verify to mark payment_received)
              (
                request.auth.uid == existing().buyerId
                && existing().status == 'payment_instruction'
                && incoming().diff(existing()).affectedKeys().hasOnly(['paymentProofNote', 'paymentProofUrl', 'updatedAt'])
              ) ||
              // Action 3: Seller shares account handover details after admin confirmed payment -> id_exchange
              (
                request.auth.uid == existing().sellerId
                && existing().status == 'id_exchange'
                && incoming().status == 'review_prompt'
                && incoming().sellerExchanged == true
                && incoming().diff(existing()).affectedKeys().hasOnly(['sellerExchanged', 'accountDetailsNote', 'status', 'updatedAt'])
              ) ||
              // Action 4: Buyer/seller writes review feedback (Only Admin can transition status -> done on payout release)
              (
                (request.auth.uid == existing().buyerId || request.auth.uid == existing().sellerId)
                && existing().status == 'review_prompt'
                && incoming().diff(existing()).affectedKeys().hasOnly(['reviewRating', 'reviewComment', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if isValidId(dealId) && isMainAdmin();

      match /messages/{messageId} {
        function parentDeal() {
          return get(/databases/$(database)/documents/deals/$(dealId)).data;
        }

        allow get: if isValidId(dealId) && isValidId(messageId) && (isDealParticipant(parentDeal()) || isAdmin());
        allow list: if isSignedIn() && (isDealParticipant(parentDeal()) || isAdmin());
        allow create: if isValidId(dealId)
          && isValidId(messageId)
          && isVerifiedUser()
          && (isDealParticipant(parentDeal()) || isAdmin())
          && isValidMessage(incoming(), messageId);
        allow delete: if isValidId(dealId) && isValidId(messageId) && isMainAdmin();
      }

      match /reviews/{reviewId} {
        function parentDealRev() {
          return get(/databases/$(database)/documents/deals/$(dealId)).data;
        }

        allow get: if isValidId(dealId) && isValidId(reviewId);
        allow list: if resource.data.dealId == dealId;
        allow create: if isValidId(dealId)
          && isValidId(reviewId)
          && isVerifiedUser()
          && (request.auth.uid == parentDealRev().buyerId || request.auth.uid == parentDealRev().sellerId)
          && isValidReview(incoming(), reviewId, dealId);
      }
    }

    // Notifications (strictly recipient-scoped; non-admins cannot spoof system alerts)
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().recipientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isBootstrapAdmin());
      allow create: if isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotification(incoming(), notificationId)
        && (!('targetType' in incoming()) || incoming().targetType != 'system' || isAdmin());
      allow update: if isValidId(notificationId) && isVerifiedUser() && existing().recipientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isValidId(notificationId) && (isMainAdmin() || (isVerifiedUser() && existing().recipientId == request.auth.uid));
    }

    // Financial statements (strictly admin-verified for payouts & fee income)
    match /statements/{statementId} {
      allow get: if isValidId(statementId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
      allow create: if isValidId(statementId) && isVerifiedUser() && isValidStatement(incoming(), statementId) && isAdmin();
      allow delete: if isValidId(statementId) && (isMainAdmin() || (isVerifiedUser() && existing().userId == request.auth.uid));
    }

    // Platform escrow payment settings (readable by signed-in traders, writable only by Main Project Admin)
    match /platformConfig/{configId} {
      allow get: if isValidId(configId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.id == 'escrow';
      allow create, update: if isValidId(configId) && isMainAdmin() && isValidPlatformConfig(incoming(), configId);
    }

    // Real-time bKash/Nagad gateway checkout sessions
    match /paymentSessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (existing().buyerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isMainAdmin());
      allow create: if isValidId(sessionId)
        && isVerifiedUser()
        && isValidPaymentSession(incoming(), sessionId)
        && incoming().buyerId == request.auth.uid
        && get(/databases/$(database)/documents/deals/$(incoming().dealId)).data.buyerId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(sessionId)
        && isValidPaymentSession(incoming(), sessionId)
        && incoming().buyerId == existing().buyerId
        && incoming().dealId == existing().dealId
        && incoming().amount == existing().amount
        && incoming().mode == existing().mode
        && incoming().gatewayPaymentId == existing().gatewayPaymentId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            isVerifiedUser()
            && existing().buyerId == request.auth.uid
            && !(existing().status in ['verified', 'expired'])
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'trxId', 'senderMasked', 'updatedAt'])
          )
        );
      allow delete: if isValidId(sessionId) && (isMainAdmin() || (isVerifiedUser() && existing().buyerId == request.auth.uid));
    }
  }
}
