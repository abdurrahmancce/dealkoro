# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Official bKash Tokenized Checkout API v1.2.0-beta (Server-side only; falls back to Sandbox if missing)
# Set BKASH_ENV=sandbox to test against bKash vendor sandbox with sandbox credentials; omit or set production to use https://tokenized.pay.bka.sh/v1.2.0-beta
# BKASH_ENV=production
# BKASH_BASE_URL=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=

# Official Nagad Remote Payment Gateway API v-0.2.0 (Server-side only; falls back to Sandbox if missing)
# Set NAGAD_ENV=sandbox to test against Nagad vendor sandbox with sandbox credentials; omit or set production to use https://api.mynagad.com/api/dfs
# NAGAD_ENV=production
# NAGAD_BASE_URL=
# NAGAD_MERCHANT_ID=
# NAGAD_MERCHANT_NUMBER=
# NAGAD_PUBLIC_KEY=
# NAGAD_PRIVATE_KEY=

# Google Maps Platform API Key (Client-side Maps JS, Places New, Routes)
# VITE_GOOGLE_MAPS_API_KEY=
